# =================================================================
# FindIt AI - Docker Deployment Environment Configuration
# =================================================================
# Copy this file to .env before starting Docker Compose:
#   cp .env.docker.example .env
# =================================================================

# Database Configuration (PostgreSQL inside Docker network)
POSTGRES_USER=findit
POSTGRES_PASSWORD=generate_a_secure_postgres_password_here
POSTGRES_DB=findit_ai

# Security (JWT secret key - generate with: openssl rand -hex 32)
SECRET_KEY=generate_a_random_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENVIRONMENT=production

# Gemini AI Key (for verification semantic analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed Origins (leave * for IP-based deployment, or add comma-separated domains later)
ALLOWED_ORIGINS=*

# Logging level (INFO, WARNING, ERROR)
LOG_LEVEL=INFO
